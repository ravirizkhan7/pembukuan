const __vite__css = "/* ==========================================================================\n   DESIGN SYSTEM - SISTEM PEMBUKUAN SPBU (AKRUAL)\n   Refinement Tahap Kedua: Color System, Visual Hierarchy, Depth & Identity\n   Prinsip: Professional, Clean, Strong Color Identity (Blue-White-Red Palette)\n   Target: Tablet Android (Landscape & Portrait) & Desktop Web\n   ========================================================================== */\n\n:root {\n  /* ==========================================\n     PALETTE WAJIB - BLUE SCALE\n     ========================================== */\n  --blue-900: #03045E; /* Deep Navy / Base Brand */\n  --blue-800: #023E8A; /* Dark Blue / Hover & Active */\n  --blue-700: #0077B6; /* Primary Blue / Visual Anchor */\n  --blue-600: #0096C7; /* Cerulean / Accent & Focus */\n  --blue-500: #00B4D8; /* Sky Cyan / Highlights */\n  --blue-400: #48CAE4; /* Light Accent */\n  --blue-300: #90E0EF; /* Soft Border & Glow */\n  --blue-200: #ADE8F4; /* Pale Tint */\n  --blue-100: #CAF0F8; /* Light Tint / Active Surface */\n  --blue-50:  #F0F8FF; /* Very Subtle Blue Tint */\n\n  /* ==========================================\n     PALETTE WAJIB - RED SCALE (Functional Accent Only)\n     ========================================== */\n  --red-900: #7F1D1D; /* Merah Sangat Gelap */\n  --red-800: #991B1B; /* Merah Gelap (Hover/Active) */\n  --red-700: #D32F2F; /* Merah Utama (Danger / Destructive) */\n  --red-600: #EF4444; /* Merah Medium */\n  --red-300: #FCA5A5; /* Merah Muda (Border) */\n  --red-100: #FEE2E2; /* Merah Sangat Muda (Background Alert) */\n  --red-50:  #FFF1F2; /* Merah Ultra Light */\n\n  /* ==========================================\n     SEMANTIC COLOR TOKENS\n     ========================================== */\n  --color-primary: var(--blue-700);\n  --color-primary-dark: var(--blue-800);\n  --color-primary-darkest: var(--blue-900);\n  --color-primary-active: var(--blue-600);\n  --color-primary-accent: var(--blue-500);\n  --color-primary-light: var(--blue-100);\n  --color-primary-subtle: var(--blue-50);\n  --color-primary-border: var(--blue-300);\n\n  --color-danger: var(--red-700);\n  --color-danger-dark: var(--red-800);\n  --color-danger-medium: var(--red-600);\n  --color-danger-border: var(--red-300);\n  --color-danger-light: var(--red-100);\n  --color-danger-subtle: var(--red-50);\n\n  --color-success: #15803D;\n  --color-success-light: #DCFCE7;\n  --color-warning: #B45309;\n  --color-warning-light: #FEF3C7;\n\n  /* Neutrals & Surfaces */\n  --color-white: #FFFFFF;\n  --color-page: #F4F6F9;\n  --color-surface: #FFFFFF;\n  --color-surface-subtle: #F8FAFD;\n  --color-surface-hover: #F0F6FA;\n  --color-border: #D2DCE6;\n  --color-border-subtle: #E2E8F0;\n  --color-border-focus: var(--blue-700);\n\n  --color-dark-text: #0F172A;\n  --color-muted-text: #5A6B82;\n\n  /* Aliases for backwards compatibility */\n  --color-primary-blue: var(--color-primary);\n  --color-dark-blue: var(--color-primary-dark);\n  --color-light-blue: var(--color-primary-light);\n  --color-blue-hover: var(--color-primary-dark);\n  --color-background: var(--color-page);\n  --color-card-surface: var(--color-surface);\n  --color-red-accent: var(--color-danger);\n  --color-red-light: var(--color-danger-light);\n  --color-green-success: var(--color-success);\n  --color-green-light: var(--color-success-light);\n  --color-amber-warning: var(--color-warning);\n  --color-amber-light: var(--color-warning-light);\n\n  /* Elevation & Shadows (Crisp layering, non-muddy) */\n  --shadow-xs: 0 1px 2px rgba(3, 4, 94, 0.04);\n  --shadow-sm: 0 1px 3px rgba(3, 4, 94, 0.06), 0 1px 2px rgba(3, 4, 94, 0.04);\n  --shadow-md: 0 4px 6px -1px rgba(3, 4, 94, 0.07), 0 2px 4px -1px rgba(3, 4, 94, 0.04);\n  --shadow-lg: 0 10px 15px -3px rgba(3, 4, 94, 0.08), 0 4px 6px -2px rgba(3, 4, 94, 0.04);\n  --shadow-command: 0 4px 14px rgba(0, 119, 182, 0.09), 0 1px 3px rgba(3, 4, 94, 0.05);\n  --shadow-modal: 0 20px 25px -5px rgba(3, 4, 94, 0.15), 0 10px 10px -5px rgba(3, 4, 94, 0.06);\n\n  /* Geometry & Rhythm */\n  --border-radius-xs: 3px;\n  --border-radius-sm: 5px;\n  --border-radius-md: 7px;\n  --border-radius-lg: 10px;\n  --min-touch-target: 44px;\n  --sidebar-width: 250px;\n  --topbar-height: 56px;\n\n  /* Typography & Animation */\n  --font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;\n  --transition-fast: 0.14s cubic-bezier(0.4, 0, 0.2, 1);\n}\n\n/* Global Reset */\n*, *::before, *::after {\n  box-sizing: border-box;\n  margin: 0;\n  padding: 0;\n}\n\nhtml, body {\n  height: 100%;\n  font-family: var(--font-family);\n  background-color: var(--color-page);\n  color: var(--color-dark-text);\n  font-size: 14px;\n  line-height: 1.5;\n  -webkit-font-smoothing: antialiased;\n}\n\n#root {\n  min-height: 100vh;\n  display: flex;\n  flex-direction: column;\n}\n\n/* Typography Hierarchy */\nh1, h2, h3, h4, h5, h6 {\n  color: var(--color-dark-text);\n  font-weight: 700;\n  line-height: 1.3;\n}\n\nh1 { font-size: 1.25rem; } /* 20px */\nh2 { font-size: 1.125rem; } /* 18px */\nh3 { font-size: 1rem; }     /* 16px */\nh4 { font-size: 0.875rem; } /* 14px */\n\np {\n  color: var(--color-dark-text);\n}\n\n.text-muted {\n  color: var(--color-muted-text);\n}\n\n.text-primary {\n  color: var(--color-primary);\n}\n\n.text-danger {\n  color: var(--color-danger);\n}\n\n.text-success {\n  color: var(--color-success);\n}\n\n/* Layout Containers */\n.app-container {\n  display: flex;\n  min-height: 100vh;\n  width: 100%;\n  background-color: var(--color-page);\n  position: relative;\n}\n\n.main-wrapper {\n  flex: 1;\n  display: flex;\n  flex-direction: column;\n  min-width: 0;\n  min-height: 100vh;\n}\n\n.page-content {\n  flex: 1;\n  padding: 22px 26px;\n  max-width: 1440px;\n  width: 100%;\n  margin: 0 auto;\n}\n\n/* ==========================================\n   BUTTONS (Design Tokens)\n   ========================================== */\n.btn {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 6px;\n  min-height: var(--min-touch-target);\n  padding: 0 16px;\n  font-size: 13.5px;\n  font-weight: 600;\n  border-radius: var(--border-radius-sm);\n  border: 1px solid transparent;\n  cursor: pointer;\n  transition: background-color var(--transition-fast), border-color var(--transition-fast), box-shadow var(--transition-fast), transform 0.08s ease;\n  white-space: nowrap;\n  user-select: none;\n}\n\n.btn:active:not(:disabled) {\n  transform: translateY(1px);\n}\n\n.btn-primary {\n  background-color: var(--color-primary);\n  color: var(--color-white);\n  border-color: var(--color-primary);\n  box-shadow: 0 1px 3px rgba(0, 119, 182, 0.25);\n}\n\n.btn-primary:hover:not(:disabled) {\n  background-color: var(--color-primary-dark);\n  border-color: var(--color-primary-dark);\n  box-shadow: 0 2px 5px rgba(2, 62, 138, 0.3);\n}\n\n.btn-secondary {\n  background-color: var(--color-white);\n  color: var(--color-dark-text);\n  border-color: var(--color-border);\n  box-shadow: var(--shadow-xs);\n}\n\n.btn-secondary:hover:not(:disabled) {\n  background-color: var(--color-surface-hover);\n  border-color: var(--color-primary-border);\n  color: var(--color-primary-dark);\n}\n\n.btn-outline-primary {\n  background-color: transparent;\n  color: var(--color-primary);\n  border-color: var(--color-primary);\n}\n\n.btn-outline-primary:hover:not(:disabled) {\n  background-color: var(--color-primary-light);\n  border-color: var(--color-primary);\n}\n\n.btn-danger {\n  background-color: var(--color-danger);\n  color: var(--color-white);\n  border-color: var(--color-danger);\n  box-shadow: 0 1px 3px rgba(211, 47, 47, 0.25);\n}\n\n.btn-danger:hover:not(:disabled) {\n  background-color: var(--color-danger-dark);\n  border-color: var(--color-danger-dark);\n  box-shadow: 0 2px 5px rgba(153, 27, 27, 0.3);\n}\n\n.btn-ghost {\n  background: transparent;\n  border-color: transparent;\n  color: var(--color-dark-text);\n}\n\n.btn-ghost:hover:not(:disabled) {\n  background-color: rgba(0, 119, 182, 0.08);\n  color: var(--color-primary);\n}\n\n.btn:disabled {\n  opacity: 0.5;\n  cursor: not-allowed;\n  box-shadow: none;\n}\n\n.btn-sm {\n  min-height: 36px;\n  padding: 0 12px;\n  font-size: 13px;\n}\n\n/* ==========================================\n   FORM INPUTS & COMMAND BAR\n   ========================================== */\n.form-group {\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n  margin-bottom: 14px;\n}\n\n.form-label {\n  font-size: 12.5px;\n  font-weight: 600;\n  color: var(--color-dark-text);\n  letter-spacing: 0.1px;\n}\n\n.form-label .required {\n  color: var(--color-danger);\n  margin-left: 2px;\n}\n\n.form-control, .form-select, .form-textarea {\n  min-height: var(--min-touch-target);\n  padding: 8px 12px;\n  font-size: 13.5px;\n  font-family: inherit;\n  color: var(--color-dark-text);\n  background-color: var(--color-white);\n  border: 1px solid var(--color-border);\n  border-radius: var(--border-radius-sm);\n  outline: none;\n  transition: border-color var(--transition-fast), box-shadow var(--transition-fast), background-color var(--transition-fast);\n  width: 100%;\n}\n\n.form-control:focus, .form-select:focus, .form-textarea:focus {\n  border-color: var(--color-primary);\n  box-shadow: 0 0 0 3px rgba(0, 119, 182, 0.18);\n  background-color: var(--color-white);\n}\n\n.form-control:disabled, .form-select:disabled {\n  background-color: #F1F5F9;\n  cursor: not-allowed;\n  color: var(--color-muted-text);\n  border-color: var(--color-border-subtle);\n}\n\n.form-hint {\n  font-size: 12px;\n  color: var(--color-muted-text);\n}\n\n.form-error {\n  font-size: 12px;\n  color: var(--color-danger);\n  font-weight: 600;\n}\n\n/* ==========================================\n   CARD & DEPTH LAYERING\n   ========================================== */\n.card {\n  background-color: var(--color-surface);\n  border-radius: var(--border-radius-md);\n  border: 1px solid var(--color-border);\n  box-shadow: var(--shadow-sm);\n  overflow: hidden;\n  transition: box-shadow var(--transition-fast);\n}\n\n.card-header {\n  padding: 13px 18px;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  border-bottom: 1px solid var(--color-border-subtle);\n  background-color: var(--color-surface-subtle);\n}\n\n.card-title {\n  font-size: 14px;\n  font-weight: 700;\n  color: var(--color-dark-text);\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n\n.card-body {\n  padding: 18px;\n  background-color: var(--color-surface);\n}\n\n.card-footer {\n  padding: 12px 18px;\n  border-top: 1px solid var(--color-border-subtle);\n  background-color: var(--color-surface-subtle);\n  display: flex;\n  align-items: center;\n  justify-content: flex-end;\n  gap: 10px;\n}\n\n/* Transaksi Command Box */\n.tx-command-box {\n  background: linear-gradient(180deg, var(--color-surface-subtle) 0%, var(--color-surface) 100%);\n  border: 1.5px solid var(--blue-300);\n  border-radius: var(--border-radius-md);\n  padding: 20px;\n  box-shadow: var(--shadow-command);\n  position: relative;\n  overflow: hidden;\n}\n\n.tx-command-box::before {\n  content: '';\n  position: absolute;\n  top: 0;\n  left: 0;\n  right: 0;\n  height: 3px;\n  background: linear-gradient(90deg, var(--blue-900) 0%, var(--blue-700) 50%, var(--blue-500) 100%);\n}\n\n/* ==========================================\n   STEP INDICATOR (Application Stepper)\n   ========================================== */\n.stepper-container {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  padding-bottom: 16px;\n  margin-bottom: 18px;\n  border-bottom: 1px solid var(--color-border-subtle);\n}\n\n.step-item {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  font-size: 13px;\n}\n\n.step-badge {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: 22px;\n  height: 22px;\n  border-radius: 50%;\n  font-size: 11.5px;\n  font-weight: 700;\n  transition: all var(--transition-fast);\n}\n\n.step-item.active .step-badge {\n  background-color: var(--color-primary);\n  color: var(--color-white);\n  box-shadow: 0 0 0 3px rgba(0, 119, 182, 0.2);\n}\n\n.step-item.active .step-label {\n  color: var(--color-primary-dark);\n  font-weight: 700;\n}\n\n.step-item.completed .step-badge {\n  background-color: var(--color-primary-light);\n  color: var(--color-primary-dark);\n}\n\n.step-item.completed .step-label {\n  color: var(--color-dark-text);\n  font-weight: 600;\n}\n\n.step-item.inactive .step-badge {\n  background-color: #E2E8F0;\n  color: #64748B;\n}\n\n.step-item.inactive .step-label {\n  color: var(--color-muted-text);\n  font-weight: 500;\n}\n\n.step-divider {\n  flex: 1;\n  max-width: 48px;\n  height: 2px;\n  background-color: var(--color-border-subtle);\n  border-radius: 1px;\n}\n\n.step-divider.active {\n  background-color: var(--color-primary);\n}\n\n/* ==========================================\n   STATUS BADGES\n   ========================================== */\n.badge {\n  display: inline-flex;\n  align-items: center;\n  gap: 4px;\n  padding: 3px 8px;\n  border-radius: var(--border-radius-xs);\n  font-size: 11.5px;\n  font-weight: 600;\n  line-height: 1.35;\n  letter-spacing: 0.1px;\n}\n\n.badge-primary {\n  background-color: var(--color-primary-light);\n  color: var(--color-primary-dark);\n  border: 1px solid var(--blue-200);\n}\n\n.badge-success {\n  background-color: var(--color-success-light);\n  color: var(--color-success);\n  border: 1px solid #BBF7D0;\n}\n\n.badge-danger {\n  background-color: var(--color-danger-light);\n  color: var(--color-danger-dark);\n  border: 1px solid var(--color-danger-border);\n}\n\n.badge-warning {\n  background-color: var(--color-warning-light);\n  color: var(--color-warning);\n  border: 1px solid #FDE68A;\n}\n\n.badge-neutral {\n  background-color: #F1F5F9;\n  color: var(--color-dark-text);\n  border: 1px solid var(--color-border-subtle);\n}\n\n/* ==========================================\n   TABLES (Clean, Tinted Header, Tabular Numerics)\n   ========================================== */\n.table-responsive {\n  width: 100%;\n  overflow-x: auto;\n  -webkit-overflow-scrolling: touch;\n  border: 1px solid var(--color-border);\n  border-radius: var(--border-radius-sm);\n  background: var(--color-white);\n  box-shadow: var(--shadow-xs);\n}\n\n.table {\n  width: 100%;\n  border-collapse: collapse;\n  text-align: left;\n  font-size: 13.5px;\n}\n\n.table th {\n  background-color: var(--blue-50);\n  color: var(--color-dark-text);\n  font-weight: 700;\n  padding: 11px 14px;\n  border-bottom: 1.5px solid var(--color-border);\n  white-space: nowrap;\n  font-size: 12px;\n  text-transform: uppercase;\n  letter-spacing: 0.3px;\n}\n\n.table td {\n  padding: 11px 14px;\n  border-bottom: 1px solid var(--color-border-subtle);\n  vertical-align: middle;\n  background-color: var(--color-white);\n}\n\n.table tr:last-child td {\n  border-bottom: none;\n}\n\n.table tr:hover td {\n  background-color: var(--color-surface-hover);\n}\n\n.table tr.table-selected td {\n  background-color: var(--color-primary-light);\n}\n\n.table-num {\n  text-align: right;\n  font-variant-numeric: tabular-nums;\n  font-weight: 600;\n}\n\n/* ==========================================\n   MODALS\n   ========================================== */\n.modal-overlay {\n  position: fixed;\n  inset: 0;\n  background-color: rgba(3, 4, 94, 0.45);\n  backdrop-filter: blur(2px);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  z-index: 1000;\n  padding: 16px;\n}\n\n.modal-content {\n  background-color: var(--color-white);\n  border-radius: var(--border-radius-md);\n  box-shadow: var(--shadow-modal);\n  width: 100%;\n  max-width: 560px;\n  max-height: 90vh;\n  display: flex;\n  flex-direction: column;\n  overflow: hidden;\n  border: 1px solid var(--color-border);\n}\n\n.modal-content.modal-lg {\n  max-width: 780px;\n}\n\n.modal-header {\n  padding: 14px 18px;\n  border-bottom: 1px solid var(--color-border-subtle);\n  background-color: var(--color-surface-subtle);\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n}\n\n.modal-body {\n  padding: 18px;\n  overflow-y: auto;\n  flex: 1;\n  background-color: var(--color-white);\n}\n\n.modal-footer {\n  padding: 12px 18px;\n  border-top: 1px solid var(--color-border-subtle);\n  background-color: var(--color-surface-subtle);\n  display: flex;\n  align-items: center;\n  justify-content: flex-end;\n  gap: 10px;\n}\n\n/* ==========================================\n   TABS\n   ========================================== */\n.tabs-container {\n  display: flex;\n  gap: 4px;\n  border-bottom: 1px solid var(--color-border);\n  margin-bottom: 18px;\n  overflow-x: auto;\n}\n\n.tab-btn {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  padding: 10px 16px;\n  font-size: 13.5px;\n  font-weight: 500;\n  color: var(--color-muted-text);\n  background: transparent;\n  border: none;\n  border-bottom: 2.5px solid transparent;\n  margin-bottom: -1px;\n  cursor: pointer;\n  white-space: nowrap;\n  min-height: var(--min-touch-target);\n  transition: color var(--transition-fast), border-color var(--transition-fast);\n}\n\n.tab-btn:hover {\n  color: var(--color-primary);\n  background-color: rgba(0, 119, 182, 0.04);\n}\n\n.tab-btn.active {\n  color: var(--color-primary-dark);\n  font-weight: 700;\n  border-bottom-color: var(--color-primary);\n}\n\n/* ==========================================\n   TOAST NOTIFICATION\n   ========================================== */\n.toast-container {\n  position: fixed;\n  bottom: 22px;\n  right: 22px;\n  z-index: 2000;\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n  max-width: 380px;\n}\n\n.toast {\n  background-color: var(--color-white);\n  border: 1px solid var(--color-border);\n  border-left: 4px solid var(--color-primary);\n  border-radius: var(--border-radius-sm);\n  padding: 12px 16px;\n  box-shadow: var(--shadow-md);\n  display: flex;\n  align-items: center;\n  gap: 10px;\n}\n\n.toast-success { border-left-color: var(--color-success); }\n.toast-danger { border-left-color: var(--color-danger); }\n.toast-warning { border-left-color: var(--color-warning); }\n\n/* ==========================================\n   LOGIN PAGE (Split Layout & Identity)\n   ========================================== */\n.login-page-root {\n  min-height: 100vh;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  background-color: var(--color-page);\n  padding: 24px;\n}\n\n.login-split-card {\n  display: flex;\n  width: 100%;\n  max-width: 860px;\n  min-height: 520px;\n  background-color: var(--color-white);\n  border-radius: var(--border-radius-lg);\n  border: 1px solid var(--color-border);\n  box-shadow: var(--shadow-lg);\n  overflow: hidden;\n}\n\n.login-brand-side {\n  flex: 1.1;\n  background: linear-gradient(145deg, var(--blue-900) 0%, var(--blue-800) 55%, var(--blue-700) 100%);\n  color: var(--color-white);\n  padding: 44px 36px;\n  display: flex;\n  flex-direction: column;\n  justify-content: space-between;\n  position: relative;\n  overflow: hidden;\n}\n\n.login-brand-side::after {\n  content: '';\n  position: absolute;\n  inset: 0;\n  background-image: \n    radial-gradient(circle at 10% 20%, rgba(0, 180, 216, 0.12) 0%, transparent 40%),\n    linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),\n    linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);\n  background-size: 100% 100%, 24px 24px, 24px 24px;\n  pointer-events: none;\n}\n\n.login-form-side {\n  flex: 1;\n  padding: 44px 38px;\n  display: flex;\n  flex-direction: column;\n  justify-content: center;\n  background-color: var(--color-white);\n}\n\n/* Tablet Portrait & Mobile Responsive */\n@media (max-width: 768px) {\n  .login-page-root {\n    padding: 12px;\n  }\n\n  .login-split-card {\n    flex-direction: column;\n    max-width: 440px;\n    min-height: auto;\n  }\n\n  .login-brand-side {\n    padding: 28px 24px;\n    flex: none;\n  }\n\n  .login-brand-side .login-brand-features {\n    display: none;\n  }\n\n  .login-form-side {\n    padding: 28px 24px;\n  }\n\n  .page-content {\n    padding: 14px;\n  }\n}\n\n/* ==========================================================================\n   FORMAL ACCOUNTING REPORT STYLES (LAPORAN LABA RUGI / RESMI)\n   Sesuai standar dokumen akuntansi: White paper, formal typography,\n   strict indentation hierarchy, tabular numbers, print-friendly.\n   ========================================================================== */\n\n.report-paper-container {\n  width: 100%;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n}\n\n.formal-report-toolbar {\n  width: 100%;\n  max-width: 1060px;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  flex-wrap: wrap;\n  gap: 12px;\n  margin-bottom: 16px;\n  padding: 10px 14px;\n  background-color: var(--color-white);\n  border: 1px solid var(--color-border);\n  border-radius: var(--border-radius-sm);\n}\n\n.formal-report-paper {\n  width: 100%;\n  max-width: 1060px;\n  background-color: #ffffff;\n  border: 1px solid #cbd5e1;\n  box-shadow: 0 1px 3px rgba(15, 23, 42, 0.08);\n  border-radius: 2px;\n  padding: 32px 36px;\n  color: #0f172a;\n  font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Arial, sans-serif;\n  box-sizing: border-box;\n}\n\n.formal-report-header {\n  text-align: center;\n  margin-bottom: 22px;\n  padding-bottom: 14px;\n  border-bottom: 1px solid #000000;\n}\n\n.formal-report-title {\n  font-size: 15px;\n  font-weight: 700;\n  letter-spacing: 0.6px;\n  text-transform: uppercase;\n  color: #000000;\n  margin-bottom: 4px;\n}\n\n.formal-report-period {\n  font-size: 13px;\n  font-weight: 600;\n  color: #1e293b;\n  margin-bottom: 3px;\n}\n\n.formal-report-entity {\n  font-size: 13px;\n  font-weight: 700;\n  color: #0f172a;\n  margin-bottom: 2px;\n}\n\n.formal-report-location {\n  font-size: 12px;\n  font-weight: 500;\n  color: #475569;\n  max-width: 